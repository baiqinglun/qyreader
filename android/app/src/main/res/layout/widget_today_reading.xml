<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2：今日阅读时长 + 每日目标进度。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.04"
        android:text="今日阅读"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_today_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="0:00"
        android:textColor="@color/widget_text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_today_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="未设目标"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10.5sp" />

    <ProgressBar
        android:id="@+id/widget_today_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="@color/widget_track"
        android:progressTint="@color/widget_accent" />

    <TextView
        android:id="@+id/widget_today_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="10sp" />
</LinearLayout>
